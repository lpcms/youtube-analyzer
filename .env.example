# Ключ YouTube Data API v3.
# Google Cloud Console → новый проект → включить «YouTube Data API v3»
# → Credentials → Create credentials → API key.
# Переменная БЕЗ префикса NEXT_PUBLIC_: ключ не должен попасть в клиентский бандл.
YOUTUBE_API_KEY=

# Рабочая база SQLite. Тесты ходят в db/test.db и эту переменную не трогают.
DATABASE_URL="file:./db/dev.db"
